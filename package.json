{
  "name": "faraid-case-preparation-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Shafi'i inheritance case-preparation tool under technical and scholarly validation.",
  "license": "MIT",
  "scripts": {
    "generate:production-registry": "node scripts/generate-production-registry.ts",
    "verify:production-manifest": "node scripts/verify-production-manifest.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts --no-error-on-unmatched-pattern",
    "format": "prettier --no-error-on-unmatched-pattern --write \"src/**/*.ts\" \"tests/**/*.{ts,json}\" \"scripts/**/*.ts\" \"*.config.{js,ts}\" \"*.json\" \".github/**/*.yml\"",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"src/**/*.ts\" \"tests/**/*.{ts,json}\" \"scripts/**/*.ts\" \"*.config.{js,ts}\" \"*.json\" \".github/**/*.yml\"",
    "check": "npm run verify:production-manifest && npm run typecheck && npm run lint && npm run test && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
